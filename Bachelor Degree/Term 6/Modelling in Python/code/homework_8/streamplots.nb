Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"x", "'"}], "[", "t", "]"}], "==", 
      RowBox[{
       RowBox[{"a", " ", 
        RowBox[{"x", "[", "t", "]"}]}], "+", 
       RowBox[{"b", " ", 
        RowBox[{"y", "[", "t", "]"}]}]}]}], "&&", 
     RowBox[{
      RowBox[{
       RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "b"}], " ", 
        RowBox[{"x", "[", "t", "]"}]}], "+", 
       RowBox[{"a", " ", 
        RowBox[{"y", "[", "t", "]"}]}]}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], ",", 
     RowBox[{"y", "[", "t", "]"}]}], "}"}], ",", "t"}], "]"}]], "Input",
 CellChangeTimes->{{3.924441651134721*^9, 3.9244417001518173`*^9}},
 CellLabel->"In[62]:=",ExpressionUUID->"2d1e54c3-3a2d-4098-a288-3abe1826b7a5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], "\[Rule]", 
     RowBox[{
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"a", " ", "t"}]], " ", 
       TemplateBox[{"1"},
        "C"], " ", 
       RowBox[{"Cos", "[", 
        RowBox[{"b", " ", "t"}], "]"}]}], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"a", " ", "t"}]], " ", 
       TemplateBox[{"2"},
        "C"], " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"b", " ", "t"}], "]"}]}]}]}], ",", 
    RowBox[{
     RowBox[{"y", "[", "t", "]"}], "\[Rule]", 
     RowBox[{
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"a", " ", "t"}]], " ", 
       TemplateBox[{"2"},
        "C"], " ", 
       RowBox[{"Cos", "[", 
        RowBox[{"b", " ", "t"}], "]"}]}], "-", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"a", " ", "t"}]], " ", 
       TemplateBox[{"1"},
        "C"], " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"b", " ", "t"}], "]"}]}]}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{{3.924441676973215*^9, 3.92444170056425*^9}},
 CellLabel->"Out[62]=",ExpressionUUID->"8c007507-9d51-4ba9-9443-1cebab6c46df"]
}, Open  ]],

